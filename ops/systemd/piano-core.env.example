# Piano Core appliance configuration (systemd EnvironmentFile contract).
#
# Copy to /etc/piano-core/piano-core.env and adjust per appliance.
# ONLY the variables below are supported by piano_core.config.AppConfig.
# Unknown PIANO_CORE_* variables are rejected (fail closed), so do not add
# speculative settings here. No secrets belong in this file.
#
# Values are parsed case-insensitively; see src/piano_core/config.py.

# Runtime mode of the appliance process.
# Allowed: development | production | test
PIANO_CORE_MODE=production

# Application log level.
# Allowed: DEBUG | INFO | WARNING | ERROR
PIANO_CORE_LOG_LEVEL=INFO

# MIDI input (Roland). Disabled by default; set to true to enable input.
#PIANO_CORE_MIDI_INPUT_ENABLED=true

# Case-insensitive input port name matcher (fail closed on ambiguity).
#PIANO_CORE_MIDI_INPUT_PORT_MATCHER=roland

# MIDI output (Roland). Disabled by default (P007 safe default; opening
# emits nothing). PIANO-P012: required for playback through the local
# control API.
#PIANO_CORE_MIDI_OUTPUT_ENABLED=true

# Case-insensitive output port name matcher (fail closed on ambiguity).
#PIANO_CORE_MIDI_OUTPUT_PORT_MATCHER=roland

# Song library (P010/P011). Disabled by default; the production appliance
# uses the service-facing read-only mount and service-owned index.
#PIANO_CORE_LIBRARY_ENABLED=true
#PIANO_CORE_LIBRARY_ROOT=/srv/piano-core/midi
#PIANO_CORE_LIBRARY_INDEX_PATH=/var/lib/piano-core/library/library.sqlite3

# Local control API (P012). Disabled by default and bound to LOOPBACK;
# LAN exposure is an explicit production decision. UNAUTHENTICATED
# trusted-LAN surface — see docs/operations/API.md. Port must be
# 1..65535; host must be an IPv4 literal or 'localhost'.
#PIANO_CORE_API_ENABLED=true
#PIANO_CORE_API_HOST=127.0.0.1
#PIANO_CORE_API_PORT=8788
# PIANO-P015-HF2: appliance deployments should bind 0.0.0.0 (all
# interfaces) — the bind succeeds before the network is up at cold
# boot and follows DHCP address changes without reconfiguration
# (same unauthenticated trusted-LAN surface as any specific LAN bind):
#PIANO_CORE_API_HOST=0.0.0.0

# Packaged web UI (P013). Enabled by default; served on the API bind
# (same origin, allowlisted static assets only, trusted LAN — no auth).
# Set to false to restore the bare API-only surface.
#PIANO_CORE_UI_ENABLED=false

# Keyboard LED subsystem (P014). Disabled by default (safe default);
# production enables it explicitly once the ESP32 keyboard controller is
# repointed to the Piano Core WebSocket endpoint (ADR-LED-KEYBOARD-V1).
# The subsystem is VISUAL OUTPUT ONLY and auxiliary: any failure degrades
# LED visualization while the service stays healthy.
#PIANO_CORE_LED_ENABLED=true
#PIANO_CORE_LED_WS_HOST=127.0.0.1
#PIANO_CORE_LED_WS_PORT=8787
# PIANO-P015-HF2: bind 0.0.0.0 on the appliance so the endpoint is
# listening before the network is up at cold boot (the ESP32 dials the
# appliance address and reconnects on its own once its Wi-Fi is up):
#PIANO_CORE_LED_WS_HOST=0.0.0.0
# Allowed: off | playback | physical | all
#PIANO_CORE_LED_MODE=playback
# Percent 0..100; scales the reported velocity (firmware brightness is fixed).
#PIANO_CORE_LED_BRIGHTNESS=100

# Persistent device identity (PROD-001). Empty/unset = the identity
# feature is UNCONFIGURED (the application performs no identity I/O).
# When set it must be an ABSOLUTE path to an existing directory owned
# by the service user with mode 0700 (record 0600). The application
# only LOADS the identity — creation happens exactly once per appliance
# via `piano-core-identity initialize --directory <dir>` AFTER the
# image is placed on the individual appliance. NEVER regenerated or
# repaired automatically; see docs/operations/DEVICE_IDENTITY.md.
# NOTE (rollback): older releases REJECT unknown PIANO_CORE_* keys —
# remove this line before launching a pre-PROD-001 release.
#PIANO_CORE_DEVICE_IDENTITY_DIR=/var/lib/piano-core/identity
